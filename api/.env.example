DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/demo
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/demo
REDIS_URL=redis://127.0.0.1:6379/0
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false

# MinIO root credentials are used only by the container initializer.
MINIO_ROOT_USER=pointcloud-root
MINIO_ROOT_PASSWORD=replace-with-a-long-random-root-password
# The API uses this separate application account.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=pointcloud-api
MINIO_SECRET_KEY=replace-with-a-long-random-application-secret
MINIO_BUCKET=point-clouds
MINIO_SECURE=false
MINIO_REGION=us-east-1

# Upload chunks remain temporary local files until completion.
UPLOAD_TEMP_DIR=data/upload-parts
# Used only to migrate files created by the earlier local-disk implementation.
LEGACY_UPLOAD_DIR=data/uploads
BUNDLED_SAMPLE_PATH=../NEONDSSampleLiDARPointCloud.las
MAX_UPLOAD_SIZE_BYTES=536870912
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_SESSION_HOURS=24
MAX_PREVIEW_POINTS=200000
